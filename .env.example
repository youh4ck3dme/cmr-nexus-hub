# ── Supabase (povinné pre app + auth) ─────────────────────────────
# Skopíruj z Lovable Cloud / Supabase Dashboard → Project Settings → API
SUPABASE_PROJECT_ID=
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_PUBLISHABLE_KEY=

# Vite client-side aliases (musia sedieť s hore)
VITE_SUPABASE_PROJECT_ID=
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=

# Server-only (webhooky, admin operácie) — NIKDY do VITE_*
SUPABASE_SERVICE_ROLE_KEY=

# ── Connectors / sync (voliteľné, inak mock) ──────────────────────
LOVABLE_API_KEY=
GITHUB_API_KEY=
# alias používaný v UI checkliste:
GITHUB_TOKEN=
VERCEL_TOKEN=
# WordPress Application Password flow
WORDPRESS_SITE_URL=
WORDPRESS_USERNAME=
WORDPRESS_APP_PASSWORD=

# ── Public webhooks ───────────────────────────────────────────────
# HMAC secret pre POST /api/public/hooks/base44 (header x-base44-signature)
BASE44_WEBHOOK_SECRET=
# Bearer token pre POST /api/public/hooks/imessage
IMESSAGE_INTAKE_TOKEN=

# ── Future / optional ─────────────────────────────────────────────
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
CRM_AUTH_TOKEN=
OPENAI_API_KEY=
MISTRAL_API_KEY=
